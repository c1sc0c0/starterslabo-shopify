# Portal login (only needed for --apply / --close)
STARTERSLABO_EMAIL=you@example.com
STARTERSLABO_PASSWORD=your-password-here

# Dagontvangsten factuur uses YOUR address (not the Shopify customer).
STARTERSLABO_DO_NAME=DO Your Name
STARTERSLABO_DO_EMAIL=
STARTERSLABO_DO_ADDRESS=
STARTERSLABO_DO_CITY=
STARTERSLABO_DO_POSTAL=

# Paper dagontvangstenboek PDF header
# STARTERSLABO_BTW_NR=BE 0876 478 439
# STARTERSLABO_DOSSIER_NR=5xxxxxx
# First month of the physical book = page N° 1 (YYYY-MM)
# STARTERSLABO_DO_BOOK_START=2026-09

# Optional: Shopify shop / fee GL account
# SHOPIFY_SHOP=your-shop.myshopify.com
# STARTERSLABO_SHOPIFY_FEE_ACCOUNT=612125
